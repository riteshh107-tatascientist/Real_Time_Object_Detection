# Copy to .env for local use. NEVER commit the real .env file.
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=choose-a-long-password-min-8-chars

# Optional: buttons on the Founder & About tab
# CONTACT_LINKEDIN=https://www.linkedin.com/in/your-name
# CONTACT_GITHUB=https://github.com/your-name
# CONTACT_EMAIL=you@example.com

# Optional tuning (defaults shown)
# PROCESS_WIDTH=960               # 640 on hosted servers
# YOLO_IMGSZ=640
# MAX_VIDEO_FRAMES=600
# CAM_MAX_WIDTH=640               # frame width sent by the live camera; lower = faster on slow networks
# ALLOWED_MODELS=yoloe-11s-seg-pf.pt,yoloe-11m-seg-pf.pt,yolo11n.pt,yolo11s.pt
# DATA_DIR=./data
# PERSISTENT_STORAGE=true         # set true only if DATA_DIR is on a persistent disk
# RETENTION_DAYS=30
